# 复制成 .env 后填入真实值。.env 已被 .gitignore 排除，不会进仓库。
#
#   cp .env.example .env
#
# 只有你打算用的那个 Provider 需要填 Key，其余留空即可。

# ---- 模型 Provider ----
# 可选值：deepseek | ollama | anthropic
DEFAULT_PROVIDER=deepseek

# DeepSeek —— 国内直连，注册即用：https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Ollama —— 本地跑，不需要 Key。先在本地 `ollama pull qwen2.5:7b`
OLLAMA_MODEL=qwen2.5:7b

# Claude
ANTHROPIC_API_KEY=

# ---- 服务 ----
DEBUG=false
PORT=8000
